{
  "name": "saphnexa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "node tools/check-repo-lint.js",
    "typecheck": "node tools/check-type-surface.js",
    "test": "node --test tests/*.test.js",
    "test:contract": "node tools/check-contracts.js",
    "test:integration:local": "node --test tests/integration-local.test.js",
    "test:e2e:local": "node --test tests/e2e-local.test.js",
    "cdk:synth:local": "node tools/check-cdk-inventory.js",
    "cdk:diff:local": "node tools/check-cdk-diff-baseline.js",
    "cfn:inventory:build": "node tools/build-cloudformation-inventory.js",
    "cfn:inventory:check": "node tools/check-cloudformation-inventory.js",
    "edge:security:check": "node tools/check-edge-security-intent.js",
    "security:scan": "node tools/check-security-scan.js",
    "license:scan": "node tools/check-license-scan.js",
    "coverage:check": "node tools/check-coverage.js",
    "ui:check": "node tools/check-ui-quality.js",
    "web:flow:check": "node tools/check-web-flows.js",
    "web:a11y:check": "node tools/check-web-accessibility-report.js",
    "web:perf:local": "node tools/check-web-performance.js",
    "web:bundle:check": "node tools/check-web-bundle-report.js",
    "perf:api:local": "node tools/check-api-performance.js",
    "failure:check": "node tools/check-failure-injection.js",
    "rag:quality:check": "node tools/check-rag-quality.js",
    "rag:security:check": "node tools/check-rag-security.js",
    "rag:perf:local": "node tools/check-rag-performance.js",
    "db:migration:check": "node tools/check-db-migrations.js",
    "db:integrity:check": "node tools/check-db-integrity.js",
    "search:local:check": "node tools/check-local-search.js",
    "observability:check": "node tools/check-observability-catalog.js",
    "admin:workflow:check": "node tools/check-admin-workflows.js",
    "offline-artifacts:check": "node tools/check-offline-artifacts.js",
    "restore:drill:check": "node tools/check-restore-drill.js",
    "docs:check": "node tools/check-docs.js",
    "evidence:check": "node tools/check-evidence-manifest.js",
    "acceptance:source:check": "node tools/check-acceptance-source-catalog.js",
    "acceptance:check": "node tools/check-acceptance-trace.js",
    "acceptance:package:build": "node tools/build-acceptance-package.js",
    "acceptance:package:check": "npm run acceptance:package:build && node tools/check-acceptance-package.js",
    "acceptance:final:build": "node tools/build-final-acceptance-readiness.js",
    "acceptance:final:check": "node tools/check-final-acceptance-readiness.js",
    "acceptance:final-candidate:check": "node tools/check-final-evidence-candidate.js",
    "acceptance:final-candidate:fixture:check": "node tools/check-final-evidence-candidate-fixtures.js",
    "acceptance:external-actions:build": "node tools/build-external-acceptance-actions.js",
    "acceptance:external-actions:check": "node tools/check-external-acceptance-actions.js",
    "ci:check": "node tools/check-ci-workflow.js",
    "pairwise:check": "node tools/check-pairwise.js",
    "perf:local": "node tools/check-local-performance.js",
    "cost:check": "node tools/check-cost-estimate.js",
    "storage:check": "node tools/check-storage-metadata.js",
    "docs-site:build": "node tools/build-admin-docs.js",
    "allure:generate:local": "node tools/build-admin-test-report.js",
    "admin-artifacts:build": "npm run docs-site:build && npm run allure:generate:local",
    "artifacts:check": "node tools/check-admin-artifacts.js",
    "scan:bundle-domains": "node tools/scan-bundle-domains.js",
    "verify": "npm run lint && npm run typecheck && npm run test:contract && npm run test:integration:local && npm run test:e2e:local && npm run cdk:synth:local && npm run cdk:diff:local && npm run cfn:inventory:build && npm run cfn:inventory:check && npm run edge:security:check && npm run security:scan && npm run license:scan && npm run coverage:check && npm run ui:check && npm run web:flow:check && npm run web:a11y:check && npm run web:perf:local && npm run web:bundle:check && npm run perf:api:local && npm run failure:check && npm run rag:quality:check && npm run rag:security:check && npm run rag:perf:local && npm run db:migration:check && npm run db:integrity:check && npm run search:local:check && npm run observability:check && npm run admin:workflow:check && npm run offline-artifacts:check && npm run restore:drill:check && npm run docs:check && npm run evidence:check && npm run acceptance:source:check && npm run acceptance:check && npm run acceptance:external-actions:build && npm run acceptance:external-actions:check && npm run acceptance:final-candidate:check && npm run acceptance:final-candidate:fixture:check && npm run acceptance:final:build && npm run acceptance:final:check && npm run acceptance:package:build && npm run acceptance:package:check && npm run pairwise:check && npm run perf:local && npm run cost:check && npm run storage:check && npm run admin-artifacts:build && npm run artifacts:check && npm run scan:bundle-domains"
  },
  "engines": {
    "node": ">=20"
  }
}
