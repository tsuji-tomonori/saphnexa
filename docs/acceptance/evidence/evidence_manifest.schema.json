{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Saphnexa Acceptance Evidence Manifest",
  "type": "object",
  "required": [
    "system",
    "environment",
    "aws_region",
    "aws_account_id",
    "git_commit_sha",
    "git_tag",
    "cloudformation_stacks",
    "db_migration",
    "test_reports",
    "docs_site",
    "rag_evaluation",
    "cost_estimate"
  ],
  "properties": {
    "system": { "const": "Saphnexa" },
    "environment": { "type": "string", "enum": ["dev", "uat", "stg", "prod"] },
    "aws_region": { "type": "string", "const": "ap-northeast-1" },
    "aws_account_id": { "type": "string", "pattern": "^[0-9]{12}$" },
    "git_commit_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "git_tag": { "type": "string", "minLength": 1 },
    "cdk_app_version": { "type": "string" },
    "cloudformation_stacks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["stack_name", "stack_id"],
        "properties": {
          "stack_name": { "type": "string" },
          "stack_id": { "type": "string" }
        }
      }
    },
    "db_migration": {
      "type": "object",
      "required": ["tool", "latest_version", "checksum_status"],
      "properties": {
        "tool": { "type": "string" },
        "latest_version": { "type": "string" },
        "checksum_status": { "type": "string", "enum": ["matched"] }
      }
    },
    "test_reports": {
      "type": "object",
      "required": ["allure_latest_url", "unit_report_url", "integration_report_url", "e2e_report_url"]
    },
    "docs_site": {
      "type": "object",
      "required": ["latest_url", "version_url"]
    },
    "rag_evaluation": {
      "type": "object",
      "required": ["evaluation_run_id", "report_url"]
    },
    "cost_estimate": {
      "type": "object",
      "required": ["monthly_usd", "assumption"],
      "properties": {
        "monthly_usd": { "type": "number", "maximum": 550 },
        "assumption": { "type": "string" }
      }
    }
  }
}
