{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Saphnexa CloudFormation Inventory",
  "type": "object",
  "required": [
    "schema_version",
    "system",
    "environment",
    "aws_region",
    "stack_name",
    "source",
    "final_acceptance_eligible",
    "aws_capture_required",
    "local_cdk_inventory",
    "expected_major_resource_types",
    "final_capture_instructions"
  ],
  "properties": {
    "schema_version": { "const": "saphnexa-cloudformation-inventory.v1" },
    "system": { "const": "Saphnexa" },
    "environment": { "type": "string", "enum": ["dev", "uat", "stg", "prod"] },
    "aws_region": { "type": "string", "const": "ap-northeast-1" },
    "stack_name": { "type": "string", "minLength": 1 },
    "stack_id": { "type": "string" },
    "source": { "type": "string", "enum": ["local-cdk-intent", "aws-cloudformation-inventory"] },
    "generated_by": { "type": "string" },
    "generated_at": { "type": "string" },
    "final_acceptance_eligible": { "type": "boolean" },
    "aws_capture_required": { "type": "boolean" },
    "local_cdk_inventory": {
      "type": "object",
      "required": ["construct_count", "constructs", "expected_resource_symbols", "expected_output_symbols", "checksum"]
    },
    "expected_major_resource_types": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^AWS::" }
    },
    "final_capture_instructions": {
      "type": "object",
      "required": [
        "describe_stacks_command",
        "list_stack_resources_command",
        "normalized_final_inventory_path",
        "required_for_acceptance"
      ]
    }
  }
}
